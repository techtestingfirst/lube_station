    {"fieldname": "user_id", "fieldtype": "Data", "label": "User"},
    {"fieldname": "customer", "fieldtype": "Data", "label": "Customer"},
    {"fieldname": "service", "fieldtype": "Data", "label": "Service"},
    {"fieldname": "order_ref", "fieldtype": "Data", "label": "Order"},
    {"fieldname": "ip", "fieldtype": "Data", "label": "IP"}
