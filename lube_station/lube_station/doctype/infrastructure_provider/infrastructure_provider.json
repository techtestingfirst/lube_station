{
  "name": "Infrastructure Provider",
  "module": "Lube Station",
  "doctype": "DocType",
  "engine": "InnoDB",
  "autoname": "field:provider_name",
  "naming_rule": "By fieldname",
  "track_changes": 1,
  "fields": [
    {"fieldname": "provider_name", "fieldtype": "Data", "label": "Provider Name", "reqd": 1, "unique": 1},
    {"fieldname": "provider_type", "fieldtype": "Select", "label": "Provider Type", "options": "Cloud API\nVPS API\nDedicated Server Provider\nBare Metal API\nControl Panel\nReseller Program\nLocal Infrastructure", "reqd": 1},
    {"fieldname": "api_base_url", "fieldtype": "Data", "label": "API Base URL"},
    {"fieldname": "credential_reference", "fieldtype": "Password", "label": "Credential Reference"},
    {"fieldname": "capabilities", "fieldtype": "Code", "label": "Capabilities"},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Active\nMaintenance\nDisabled", "default": "Active", "reqd": 1}
  ],
  "permissions": [{"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}]
}
