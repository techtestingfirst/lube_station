{
  "name": "Reseller Agreement",
  "module": "Lube Station",
  "doctype": "DocType",
  "engine": "InnoDB",
  "autoname": "format:RA-{####}",
  "naming_rule": "Expression",
  "fields": [
    {"fieldname": "provider", "fieldtype": "Link", "label": "Provider", "options": "Infrastructure Provider", "reqd": 1},
    {"fieldname": "agreement_name", "fieldtype": "Data", "label": "Agreement Name", "reqd": 1},
    {"fieldname": "billing_model", "fieldtype": "Select", "label": "Billing Model", "options": "Wholesale Recurring\nPrepaid Credit\nPer Usage\nCommission", "reqd": 1},
    {"fieldname": "markup_type", "fieldtype": "Select", "label": "Markup Type", "options": "Percentage\nFixed"},
    {"fieldname": "markup_value", "fieldtype": "Float", "label": "Markup Value", "default": "0"},
    {"fieldname": "terms_json", "fieldtype": "Code", "label": "Terms JSON"},
    {"fieldname": "active", "fieldtype": "Check", "label": "Active", "default": "1"}
  ],
  "permissions": [{"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}]
}
