{
  "name": "Domain",
  "module": "Lube Station",
  "doctype": "DocType",
  "engine": "InnoDB",
  "autoname": "field:domain_name",
  "naming_rule": "By fieldname",
  "fields": [
    {"fieldname": "domain_name", "fieldtype": "Data", "label": "Domain Name", "reqd": 1, "unique": 1},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Available\nTaken\nPremium\nUnknown", "default": "Unknown"},
    {"fieldname": "last_checked", "fieldtype": "Datetime", "label": "Last Checked"},
    {"fieldname": "premium_price", "fieldtype": "Currency", "label": "Premium Price", "default": "0"}
  ],
  "permissions": [{"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}]
}
