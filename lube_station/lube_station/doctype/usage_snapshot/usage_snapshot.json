{
  "name": "Usage Snapshot",
  "module": "Lube Station",
  "doctype": "DocType",
  "engine": "InnoDB",
  "autoname": "format:USE-{####}",
  "naming_rule": "Expression",
  "fields": [
    {"fieldname": "service_ref", "fieldtype": "Link", "label": "Service", "options": "Service", "reqd": 1},
    {"fieldname": "snap_date", "fieldtype": "Date", "label": "Date", "reqd": 1},
    {"fieldname": "disk_used", "fieldtype": "Float", "label": "Disk Used", "default": "0"},
    {"fieldname": "bandwidth_used", "fieldtype": "Float", "label": "Bandwidth Used", "default": "0"}
  ],
  "permissions": [{"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}]
}
