{
  "name": "Product Group",
  "module": "Lube Catalog",
  "doctype": "DocType",
  "engine": "InnoDB",
  "autoname": "field:group_name",
  "naming_rule": "By fieldname",
  "is_submittable": 0,
  "track_changes": 1,
  "sort_field": "sort_order",
  "sort_order": "ASC",
  "fields": [
    {"fieldname": "group_name", "fieldtype": "Data", "label": "Group Name", "reqd": 1, "unique": 1},
    {"fieldname": "slug", "fieldtype": "Data", "label": "Slug"},
    {"fieldname": "description", "fieldtype": "Text Editor", "label": "Description"},
    {"fieldname": "icon", "fieldtype": "Attach Image", "label": "Icon"},
    {"fieldname": "sort_order", "fieldtype": "Int", "label": "Sort Order", "default": "0"},
    {"fieldname": "show_on_portal", "fieldtype": "Check", "label": "Show On Portal", "default": "1"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}
  ]
}
