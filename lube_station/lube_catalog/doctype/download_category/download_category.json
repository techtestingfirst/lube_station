{
  "name": "Download Category",
  "module": "Lube Catalog",
  "doctype": "DocType",
  "engine": "InnoDB",
  "autoname": "field:category_name",
  "naming_rule": "By fieldname",
  "fields": [
    {"fieldname": "category_name", "fieldtype": "Data", "label": "Category Name", "reqd": 1, "unique": 1},
    {"fieldname": "parent_category", "fieldtype": "Link", "label": "Parent Category", "options": "Download Category"},
    {"fieldname": "is_public", "fieldtype": "Check", "label": "Is Public", "default": "0"}
  ],
  "permissions": [{"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}]
}
