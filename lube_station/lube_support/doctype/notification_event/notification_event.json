{
  "name": "Notification Event",
  "module": "Lube Support",
  "doctype": "DocType",
  "engine": "InnoDB",
  "autoname": "format:NEV-{####}",
  "naming_rule": "Expression",
  "fields": [
    {"fieldname": "event_key", "fieldtype": "Data", "label": "Event Key", "reqd": 1, "unique": 1},
    {"fieldname": "event_type", "fieldtype": "Select", "label": "Event Type", "options": "signup\norder\ninvoice\npayment\nrenewal\noverdue\nsuspension\nunsuspension\ntermination\ncredentials\ndomain_renewal\ndownload\nsupport", "reqd": 1},
    {"fieldname": "reference", "fieldtype": "Data", "label": "Reference", "reqd": 1},
    {"fieldname": "recipient", "fieldtype": "Data", "label": "Recipient"}
  ],
  "permissions": [{"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 0}]
}
