{
  "name": "Cart",
  "module": "Lube Customers",
  "doctype": "DocType",
  "engine": "InnoDB",
  "autoname": "hash",
  "naming_rule": "Random",
  "fields": [
    {"fieldname": "customer", "fieldtype": "Link", "label": "Customer", "options": "Hosting Customer"},
    {"fieldname": "session_id", "fieldtype": "Data", "label": "Session ID"},
    {"fieldname": "coupon_code", "fieldtype": "Data", "label": "Coupon Code"},
    {"fieldname": "items", "fieldtype": "Table", "label": "Items", "options": "Cart Item"},
    {"fieldname": "subtotal", "fieldtype": "Currency", "label": "Subtotal", "default": "0"},
    {"fieldname": "discount_total", "fieldtype": "Currency", "label": "Discount Total", "default": "0"},
    {"fieldname": "grand_total", "fieldtype": "Currency", "label": "Grand Total", "default": "0"}
  ],
  "permissions": [{"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}, {"role": "Customer", "read": 1, "write": 1, "create": 1}]
}
