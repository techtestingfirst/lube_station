{
  "name": "Hosting Customer",
  "module": "Lube Customers",
  "doctype": "DocType",
  "engine": "InnoDB",
  "modified": "2026-10-10 17:30:00.000000",
  "autoname": "format:CUST-{####}",
  "naming_rule": "Expression",
  "track_changes": 1,
  "fields": [
    {"fieldname": "section_break_0", "fieldtype": "Section Break", "label": "Customer Details"},
    {"fieldname": "user", "fieldtype": "Link", "label": "User", "options": "User", "reqd": 1, "unique": 1},
    {"fieldname": "company", "fieldtype": "Data", "label": "Company"},
    {"fieldname": "client_group", "fieldtype": "Link", "label": "Client Group", "options": "Client Group"},
    {"fieldname": "column_break_0", "fieldtype": "Column Break"},
    {"fieldname": "credit_balance", "fieldtype": "Currency", "label": "Credit Balance", "default": "0"},
    {"fieldname": "tax_id", "fieldtype": "Data", "label": "Tax / VAT ID"},
    {"fieldname": "section_break_1", "fieldtype": "Section Break", "label": "Billing Address"},
    {"fieldname": "billing_address", "fieldtype": "Small Text", "label": "Billing Address"},
    {"fieldname": "section_break_2", "fieldtype": "Section Break", "label": "Address"},
    {"fieldname": "phone", "fieldtype": "Data", "label": "Phone"},
    {"fieldname": "address_line1", "fieldtype": "Data", "label": "Street Address"},
    {"fieldname": "city", "fieldtype": "Data", "label": "City"},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "state", "fieldtype": "Data", "label": "State / County"},
    {"fieldname": "postcode", "fieldtype": "Data", "label": "Postcode"},
    {"fieldname": "country", "fieldtype": "Link", "label": "Country", "options": "Country"},
    {"fieldname": "section_break_3", "fieldtype": "Section Break", "label": "Preferences"},
    {"fieldname": "tos_accepted", "fieldtype": "Check", "label": "TOS Accepted", "default": "0"},
    {"fieldname": "column_break_2", "fieldtype": "Column Break"},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Active\nSuspended\nClosed", "default": "Active", "reqd": 1},
    {"fieldname": "marketing_opt_in", "fieldtype": "Check", "label": "Marketing Opt-In", "default": "0"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Customer", "read": 1, "write": 0, "create": 0, "delete": 0, "if_owner": 1}
  ]
}
