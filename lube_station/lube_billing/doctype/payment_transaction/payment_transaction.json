{
  "name": "Payment Transaction",
  "module": "Lube Billing",
  "doctype": "DocType",
  "engine": "InnoDB",
  "autoname": "format:PAY-{####}",
  "naming_rule": "Expression",
  "track_changes": 1,
  "fields": [
    {"fieldname": "invoice", "fieldtype": "Link", "label": "Invoice", "options": "Hosting Invoice", "reqd": 1},
    {"fieldname": "gateway", "fieldtype": "Data", "label": "Gateway", "reqd": 1},
    {"fieldname": "gateway_txn_id", "fieldtype": "Data", "label": "Gateway Transaction ID"},
    {"fieldname": "event_id", "fieldtype": "Data", "label": "Event ID"},
    {"fieldname": "amount", "fieldtype": "Currency", "label": "Amount", "default": "0"},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Pending\nSuccess\nFailed\nRefunded", "default": "Pending", "reqd": 1},
    {"fieldname": "raw_response", "fieldtype": "Code", "label": "Raw Response"}
  ],
  "permissions": [{"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 0}]
}
