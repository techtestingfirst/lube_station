{
  "name": "Service",
  "module": "Lube Provisioning",
  "doctype": "DocType",
  "engine": "InnoDB",
  "autoname": "format:SVC-{####}",
  "naming_rule": "Expression",
  "track_changes": 1,
  "fields": [
    {"fieldname": "customer", "fieldtype": "Link", "label": "Customer", "options": "Hosting Customer", "reqd": 1},
    {"fieldname": "hosting_plan", "fieldtype": "Link", "label": "Hosting Plan", "options": "Hosting Plan", "reqd": 1},
    {"fieldname": "order_ref", "fieldtype": "Link", "label": "Order", "options": "Order"},
    {"fieldname": "billing_cycle", "fieldtype": "Select", "label": "Billing Cycle", "options": "Monthly\nQuarterly\nSemi-Annually\nAnnually\nBiennially\nTriennially\nOne Time", "default": "Monthly"},
    {"fieldname": "server", "fieldtype": "Link", "label": "Server", "options": "Server"},
    {"fieldname": "primary_domain", "fieldtype": "Data", "label": "Primary Domain"},
    {"fieldname": "svc_username", "fieldtype": "Data", "label": "Username"},
    {"fieldname": "vendor_ref", "fieldtype": "Data", "label": "Vendor Reference", "description": "Vendor-side id (VPS id, external handle)"},
    {"fieldname": "node", "fieldtype": "Data", "label": "Node", "description": "Hypervisor node (Proxmox)"},
    {"fieldname": "parent_service", "fieldtype": "Link", "label": "Parent Service", "options": "Service", "description": "WHMCS add-on link: suspend/terminate cascade from parent; add-on keeps its own billing cycle."},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Pending\nActive\nSuspended\nTerminated\nCancelled", "default": "Pending", "reqd": 1},
    {"fieldname": "next_due_date", "fieldtype": "Date", "label": "Next Due Date"},
    {"fieldname": "recurring_amount", "fieldtype": "Currency", "label": "Recurring Amount", "default": "0"},
    {"fieldname": "cancellation_requested", "fieldtype": "Check", "label": "Cancellation Requested", "default": "0", "description": "Customer asked to cancel via portal (reason + mode below). Staff terminates."},
    {"fieldname": "cancellation_mode", "fieldtype": "Select", "label": "Cancellation Mode", "options": "\nImmediate\nEnd of Billing Cycle"},
    {"fieldname": "cancellation_reason", "fieldtype": "Small Text", "label": "Cancellation Reason"},
    {"fieldname": "provisioning_log", "fieldtype": "Small Text", "label": "Provisioning Log"}
  ],
  "permissions": [{"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}]
}
