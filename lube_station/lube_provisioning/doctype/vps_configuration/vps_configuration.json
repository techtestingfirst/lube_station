{
  "name": "VPS Configuration",
  "module": "Lube Provisioning",
  "doctype": "DocType",
  "engine": "InnoDB",
  "autoname": "format:VPSCFG-{####}",
  "naming_rule": "Expression",
  "fields": [
    {"fieldname": "section_break_0", "fieldtype": "Section Break", "label": "Configuration Details"},
    {"fieldname": "hosting_plan", "fieldtype": "Link", "label": "Hosting Plan", "options": "Hosting Plan", "reqd": 1, "unique": 1},
    {"fieldname": "cpu_cores", "fieldtype": "Int", "label": "CPU Cores", "default": "1"},
    {"fieldname": "ram_mb", "fieldtype": "Int", "label": "RAM MB", "default": "1024"},
    {"fieldname": "column_break_0", "fieldtype": "Column Break"},
    {"fieldname": "storage_gb", "fieldtype": "Int", "label": "Storage GB", "default": "20"},
    {"fieldname": "bandwidth_gb", "fieldtype": "Int", "label": "Bandwidth GB", "default": "100"},
    {"fieldname": "section_break_1", "fieldtype": "Section Break", "label": "OS Images"},
    {"fieldname": "os_images_json", "fieldtype": "Code", "label": "OS Images JSON"},
    {"fieldname": "section_break_2", "fieldtype": "Section Break", "label": "Locations"},
    {"fieldname": "locations_json", "fieldtype": "Code", "label": "Locations JSON"},
    {"fieldname": "section_break_3", "fieldtype": "Section Break", "label": "Network and Billing"},
    {"fieldname": "ipv4_count", "fieldtype": "Int", "label": "IPv4 Count", "default": "1"},
    {"fieldname": "backup_enabled", "fieldtype": "Check", "label": "Backup Enabled", "default": "0"},
    {"fieldname": "disk_overage_rate", "fieldtype": "Currency", "label": "Disk Overage Rate / GB", "default": "0", "description": "WHMCS metric billing: 0 means disk overuse is not billed."},
    {"fieldname": "bandwidth_overage_rate", "fieldtype": "Currency", "label": "Bandwidth Overage Rate / GB", "default": "0", "description": "WHMCS metric billing: 0 means bandwidth overuse is not billed."}
  ],
  "permissions": [{"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}],
  "modified": "2026-10-10 17:30:00.000000"
}
