{
  "name": "Provisioning Adapter",
  "module": "Lube Provisioning",
  "doctype": "DocType",
  "engine": "InnoDB",
  "autoname": "field:adapter_name",
  "naming_rule": "By fieldname",
  "track_changes": 1,
  "fields": [
    {"fieldname": "adapter_name", "fieldtype": "Data", "label": "Adapter Name", "reqd": 1, "unique": 1},
    {"fieldname": "vendor_name", "fieldtype": "Select", "label": "Vendor Name", "options": "cPanel\nPlesk\nDirectAdmin\nVirtualizor\nProxmox\nHetzner\nAWS\nCloudflare\nCustom", "reqd": 1},
    {"fieldname": "class_path", "fieldtype": "Data", "label": "Class Path", "description": "Leave empty for known vendors, it fills on save. Enter a path only for custom code.", "depends_on": "eval:doc.vendor_name=='Custom'||!doc.class_path"},
    {"fieldname": "api_mode", "fieldtype": "Select", "label": "API Mode", "options": "\nREST\nXML API\nJSON API\nHTTP API\nWHM API\nEPP\nCustom", "description": "Protocol the vendor panel API speaks."},
    {"fieldname": "lifecycle_methods", "fieldtype": "Small Text", "label": "Lifecycle Methods", "description": "Auto-filled from the adapter code on save.", "read_only": 1},
    {"fieldname": "supports_usage", "fieldtype": "Check", "label": "Supports Usage", "default": "0"},
    {"fieldname": "supports_resize", "fieldtype": "Check", "label": "Supports Resize", "default": "0"},
    {"fieldname": "supports_sso", "fieldtype": "Check", "label": "Supports SSO", "default": "0"},
    {"fieldname": "supports_change_plan", "fieldtype": "Check", "label": "Supports Change Plan", "default": "0"},
    {"fieldname": "active", "fieldtype": "Check", "label": "Active", "default": "0"}
  ],
  "permissions": [{"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}]
}
