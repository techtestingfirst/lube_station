{
  "name": "Registrar Adapter",
  "module": "Lube Domains",
  "doctype": "DocType",
  "engine": "InnoDB",
  "autoname": "field:adapter_name",
  "naming_rule": "By fieldname",
  "track_changes": 1,
  "modified": "2026-10-10 17:30:00.000000",
  "fields": [
    {"fieldname": "section_break_0", "fieldtype": "Section Break", "label": "Adapter Details"},
    {"fieldname": "adapter_name", "fieldtype": "Data", "label": "Adapter Name", "reqd": 1, "unique": 1},
    {"fieldname": "vendor_name", "fieldtype": "Select", "label": "Vendor Name", "options": "OpenSRS\nNamecheap\nGoDaddy\nLogicBoxes\neNom\nCentralNic\nHEXONET\nPorkbun\nInternet.bs\nNominet\nCustom", "reqd": 1},
    {"fieldname": "class_path", "fieldtype": "Data", "label": "Class Path", "description": "Leave empty for known vendors, it fills on save. Enter a path only for custom code.", "depends_on": "eval:doc.vendor_name=='Custom'||!doc.class_path"},
    {"fieldname": "column_break_0", "fieldtype": "Column Break"},
    {"fieldname": "api_mode", "fieldtype": "Select", "label": "API Mode", "options": "\nREST\nXML\nEPP", "description": "Protocol the registrar API speaks."},
    {"fieldname": "section_break_1", "fieldtype": "Section Break", "label": "Supported Operations"},
    {"fieldname": "supported_operations", "fieldtype": "Small Text", "label": "Supported Operations", "description": "Auto-filled from the adapter code on save.", "read_only": 1},
    {"fieldname": "section_break_2", "fieldtype": "Section Break", "label": "Supported TLDs"},
    {"fieldname": "supported_tlds", "fieldtype": "Small Text", "label": "Supported TLDs", "description": "Comma list the vendor sells, e.g. .com, .in. Not detectable from code."},
    {"fieldname": "section_break_3", "fieldtype": "Section Break", "label": "Capabilities"},
    {"fieldname": "sandbox_supported", "fieldtype": "Check", "label": "Sandbox Supported", "default": "1"},
    {"fieldname": "supports_dns", "fieldtype": "Check", "label": "Supports DNS", "default": "0"},
    {"fieldname": "supports_privacy", "fieldtype": "Check", "label": "Supports Privacy", "default": "0"},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "supports_transfer", "fieldtype": "Check", "label": "Supports Transfer", "default": "0"},
    {"fieldname": "active", "fieldtype": "Check", "label": "Active", "default": "0"}
  ],
  "permissions": [{"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}]
